[Unit]
Description=MeetnGreet API
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=meetngreet
WorkingDirectory=/opt/meetngreet
EnvironmentFile=/opt/meetngreet/.env
ExecStart=/opt/meetngreet/venv/bin/python /opt/meetngreet/app.py
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
